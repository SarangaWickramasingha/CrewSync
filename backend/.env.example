# Copy this file to `.env` and fill in your real values.
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env (Windows)

# ── DATABASE ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crewsync
DB_USERNAME=root
DB_PASSWORD=

# ── JWT ─────────────────────────────────────────────────────────────────
# Use a long random string. Changing it invalidates all existing tokens.
JWT_SECRET=your_random_secret_here
JWT_EXPIRY=604800
JWT_COOKIE_NAME=crewsync_token

# ── MAIL (Brevo Transactional API) ──────────────────────────────────
# Works on Render free tier (no SMTP needed — the app calls the Brevo REST API).
# Get an API key at https://app.brevo.com/manage/account/keys
# BREVO_FROM_EMAIL must be a VERIFIED sender (Settings → Senders) or an
# address on a verified sending domain, else Brevo returns 400 on send.
BREVO_API_KEY=xxxxxxxxxxxxxxxxxxxx
BREVO_FROM_EMAIL=noreply@yourdomain.com
BREVO_FROM_NAME=CrewSync

# ── CORS ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000