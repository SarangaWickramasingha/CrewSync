# Copy this file to `.env` and fill in your real values.
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env (Windows)

# ── DATABASE ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crewsync
DB_USERNAME=root
DB_PASSWORD=

# ── JWT ─────────────────────────────────────────────────────────────────
# Use a long random string. Changing it invalidates all existing tokens.
JWT_SECRET=your_random_secret_here
JWT_EXPIRY=604800
JWT_COOKIE_NAME=crewsync_token

# ── MAIL (Resend HTTP API) ──────────────────────────────────────────────
# Works on Render free tier (no SMTP needed). Get an API key at https://resend.com
# For production delivery, verify your own domain in Resend and use it below;
# onboarding@resend.dev only delivers to the address you registered with.
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_ADDRESS=onboarding@resend.dev
RESEND_FROM_NAME=CrewSync

# ── CORS ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000