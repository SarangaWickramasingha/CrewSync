# Copy this file to `.env` and fill in your real values.
#   cp .env.example .env
# NOTE: The backend's Env::load() reads this file from the project ROOT.

# ── DATABASE ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crewsync
DB_USERNAME=root
DB_PASSWORD=

# ── JWT ─────────────────────────────────────────────────────────────────
# Use a long random string. Changing it invalidates all existing tokens.
JWT_SECRET=your_random_secret_here
JWT_EXPIRY=604800
JWT_COOKIE_NAME=crewsync_token

# ── MAIL (Resend HTTP API) ──────────────────────────────────────────────
# Works on Render free tier (no SMTP). API key: https://resend.com
# For production delivery, verify your own domain in Resend and set
# RESEND_FROM_ADDRESS to it; onboarding@resend.dev only delivers to the
# address you registered with Resend.
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_ADDRESS=onboarding@resend.dev
RESEND_FROM_NAME=CrewSync

# ── CORS ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000
