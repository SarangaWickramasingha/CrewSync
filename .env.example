# Copy this file to `.env` and fill in your real values.
#   cp .env.example .env
# NOTE: The backend's Env::load() reads this file from the project ROOT.

# ── DATABASE ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crewsync
DB_USERNAME=root
DB_PASSWORD=

# ── JWT ─────────────────────────────────────────────────────────────────
# Use a long random string. Changing it invalidates all existing tokens.
JWT_SECRET=your_random_secret_here
JWT_EXPIRY=604800
JWT_COOKIE_NAME=crewsync_token

# ── MAIL (Resend HTTP API) ──────────────────────────────────────────────
# Works on Render free tier (no SMTP). API key: https://resend.com
# For production delivery, verify your own domain in Resend and set
# RESEND_FROM_ADDRESS to it; onboarding@resend.dev only delivers to the
# address you registered with Resend.
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_ADDRESS=onboarding@resend.dev
RESEND_FROM_NAME=CrewSync

# ── CORS ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

# ── REPORTS ──────────────────────────────────────────────────────────────
# Backend host (no scheme) where the API is served.
# Local: localhost/CrewSync-backend/backend   Render: crewsync-1sis.onrender.com
BACKEND_HOST=

# Reports web URL = BACKEND_HOST + REPORTS_PATH.
# On Render (reports live at root /reports): REPORTS_PATH=reports/
#   -> https://crewsync-1sis.onrender.com/reports/
REPORTS_PATH=

# Full override of the reports web URL (optional, overrides BACKEND_HOST + REPORTS_PATH).
REPORTS_URL=

# Filesystem path where generated PDFs are saved.
# Empty = default <project>/backend/reports/. On Render: /var/www/html/reports/
REPORTS_DIR_PATH=
